{
  "name": "search_engine_connector_dim_v1",
  "config": {
    "connector.class": "io.confluent.connect.elasticsearch.ElasticsearchSinkConnector",
    "tasks.max": "1",
    "topics": "customer_table,customer_agg_5m,images_aggregate,improving_parts_table,market_info_table,media_type_table,vehicle_table",
    "connection.url": "http://host.docker.internal:9200",
    "key.ignore": "false",
    "schema.ignore": "true",
    "consumer.override.auto.offset.reset": "earliest",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "dlq-es-v1",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.retry.timeout": "300000",
    "errors.retry.delay.max.ms": "60000",
    "event.processing.failure.handling.mode": "fail",
    "key.converter.schemas.enable": "false",
    "confluent.topic.bootstrap.servers": "pkc-z9doz.eu-west-1.aws.confluent.cloud:9092",
    "confluent.topic.security.protocol": "SASL_SSL",
    "confluent.topic.ssl.endpoint.identification.algorithm": "https",
    "confluent.topic.sasl.mechanism": "PLAIN",
    "transforms": "customer_table_extract,customer_agg_5m_extract,images_aggregate_extract,improving_parts_table_extract,market_info_table_extract,media_type_table_extract,vehicle_table_extract",
    "predicates": "is_customer_table,is_customer_agg_5m,is_images_aggregate,is_improving_parts_table,is_market_info_table,is_media_type_table,is_vehicle_table",
    "transforms.customer_table_extract.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
    "transforms.customer_table_extract.field": "CustomerId",
    "transforms.customer_table_extract.predicate": "is_customer_table",
    "transforms.customer_agg_5m_extract.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
    "transforms.customer_agg_5m_extract.field": "CustomerId",
    "transforms.customer_agg_5m_extract.predicate": "is_customer_agg_5m",
    "transforms.images_aggregate_extract.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
    "transforms.images_aggregate_extract.field": "images_aggregate",
    "transforms.images_aggregate_extract.predicate": "is_images_aggregate",
    "transforms.improving_parts_table_extract.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
    "transforms.improving_parts_table_extract.field": "ImproveId",
    "transforms.improving_parts_table_extract.predicate": "is_improving_parts_table",
    "transforms.market_info_table_extract.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
    "transforms.market_info_table_extract.field": "MarketInfoId",
    "transforms.market_info_table_extract.predicate": "is_market_info_table",
    "transforms.media_type_table_extract.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
    "transforms.media_type_table_extract.field": "MediaTypeId",
    "transforms.media_type_table_extract.predicate": "is_media_type_table",
    "transforms.vehicle_table_extract.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
    "transforms.vehicle_table_extract.field": "VehicleId",
    "transforms.vehicle_table_extract.predicate": "is_vehicle_table",
    "predicates.is_customer_table.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.is_customer_table.pattern": "^customer_table$",
    "predicates.is_customer_agg_5m.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.is_customer_agg_5m.pattern": "^customer_agg_5m$",
    "predicates.is_images_aggregate.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.is_images_aggregate.pattern": "^images_aggregate$",
    "predicates.is_improving_parts_table.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.is_improving_parts_table.pattern": "^improving_parts_table$",
    "predicates.is_market_info_table.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.is_market_info_table.pattern": "^market_info_table$",
    "predicates.is_media_type_table.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.is_media_type_table.pattern": "^media_type_table$",
    "predicates.is_vehicle_table.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.is_vehicle_table.pattern": "^vehicle_table$"
  }
}
