{
  "index_patterns": [
    "orders_vehicle_enriched_windowed"
  ],
  "template": {
    "settings": {
        "number_of_replicas": 0,
        "number_of_shards": 1
    },
"mappings": {
    "properties": {
      "OrderId":                { "type": "keyword", "ignore_above": 512 },
      "SiteToken":              { "type": "keyword", "ignore_above": 512 },
      "Price":                  { "type": "double" },
      "StatusId":               { "type": "integer" },
      "CustomerId":             { "type": "integer" },
      "VehicleId":              { "type": "keyword", "ignore_above": 512 },
      "KM":                     { "type": "integer" },
      "PrevOwnerNumber":        { "type": "short" },
      "MarketInfoId":           { "type": "keyword", "ignore_above": 512 },
      "MediaTypeId":            { "type": "integer" },
      "YearOnRoad":             { "type": "integer" },
      "TestDate":               { "type": "integer" },
      "ImproveId":              { "type": "integer" },
      "images_count":           { "type": "long" },
      "images_urls":            { "type": "keyword", "ignore_above": 2048 },
      "StageLevel":             { "type": "short" },
      "StageText":              { "type": "keyword", "ignore_above": 512 },
      "PartsImprovedList":      { "type": "keyword", "ignore_above": 2048 },
      "AirBags":                { "type": "integer" },
      "SunRoof":                { "type": "short" },
      "MagnesiumWheels":        { "type": "short" },
      "ReversSensors":          { "type": "short" },
      "ABS":                    { "type": "short" },
      "Hybrid":                 { "type": "short" },
      "Doors":                  { "type": "short" },
      "EnvironmentFriendlyLevel": { "type": "integer" },
      "SecurityTestLevel":      { "type": "integer" },
      "ManufacturerId":         { "type": "integer" },
      "ManufacturerText":       { "type": "keyword", "ignore_above": 512 },
      "ModelId":                { "type": "integer" },
      "ModelText":              { "type": "keyword", "ignore_above": 512 },
      "SubModelId":             { "type": "integer" },
      "SubModelText":           { "type": "keyword", "ignore_above": 512 },
      "FamilyTypeId":           { "type": "integer" },
      "FamilyTypeText":         { "type": "keyword", "ignore_above": 512 },
      "Year":                   { "type": "integer" },
      "HorsePower":             { "type": "integer" },
      "CruseControl":           { "type": "short" },
      "PowerWheel":             { "type": "short" },
      "FullyAutonomic":         { "type": "short" },
      "MarketPrice":            { "type": "integer" },
      "AvailableDiskSlot":      { "type": "integer" },
      "UsbSlotType":            { "type": "keyword", "ignore_above": 256 },
      "UsbSlots":               { "type": "integer" },
      "IsTouchDisplay":         { "type": "integer" },
      "window_start":           { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
      "window_end":             { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
      "customer_total_assets":  { "type": "integer" },
      "es_sink_timestamp":  { "type": "keyword" },
      "pipeline_start":  { "type": "keyword" }
    }
  }
  }
}