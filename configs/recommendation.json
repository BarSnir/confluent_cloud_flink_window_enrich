{
    "name": "recommendation_sink_connector_v1",
    "config":{
        "topics": "orders_vehicle_enriched_windowed",
        "connector.class": "streams.kafka.connect.sink.Neo4jSinkConnector",
        "errors.log.include.messages": true,
        "neo4j.server.uri": "bolt://neo4j:7687",
        "neo4j.topic.cypher.orders_vehicle_enriched_windowed": "MERGE (v:Vhicle{manufacturer: event.ManufacturerText, model: event.ModelText, token: event.SiteToken, price:event.Price, year:event.Year}) MERGE (f:Family{family: event.FamilyTypeText}) MERGE (v)-[:FAMILY_TYPE]->(f)",
        "confluent.topic.bootstrap.servers" : "pkc-z9doz.eu-west-1.aws.confluent.cloud:9092",
        "confluent.topic.security.protocol": "SASL_SSL",
        "confluent.topic.ssl.endpoint.identification.algorithm": "https",
        "confluent.topic.sasl.mechanism": "PLAIN",
        "errors.deadletterqueue.context.headers.enable": "true",
        "errors.deadletterqueue.topic.name": "dlq-es-v1",
        "errors.log.enable": "true",
        "errors.retry.delay.max.ms": "60000",
        "errors.retry.timeout": "300000",
        "errors.tolerance": "all",
        "event.processing.failure.handling.mode": "fail",
        "transforms": "InsertField, ValueToKey, extractInt, ts, ts2, ts3, ts4",
        "transforms.InsertField.type": "org.apache.kafka.connect.transforms.InsertField$Value",
        "transforms.InsertField.timestamp.field": "es_sink_timestamp",
        "transforms.ValueToKey.type": "org.apache.kafka.connect.transforms.ValueToKey",
        "transforms.ValueToKey.fields": "OrderId",
        "transforms.extractInt.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
        "transforms.extractInt.field": "OrderId",
        "transforms.ts.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
        "transforms.ts.field":"neo4j_sink_timestamp",
        "transforms.ts.target.type":"string",
        "transforms.ts.format":"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
        "transforms.ts2.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
        "transforms.ts2.field":"pipeline_start",
        "transforms.ts2.target.type":"string",
        "transforms.ts2.format":"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
        "transforms.ts3.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
        "transforms.ts3.field":"window_start",
        "transforms.ts3.target.type":"string",
        "transforms.ts3.format":"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
        "transforms.ts4.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
        "transforms.ts4.field":"window_end",
        "transforms.ts4.target.type":"string",
        "transforms.ts4.format":"yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
        "consumer.override.auto.offset.reset": "earliest"
    }
}